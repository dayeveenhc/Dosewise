# Supabase — fill these in a git-ignored .env (do NOT commit real values)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- LLM provider (which brain Hermes uses) ---
LLM_PROVIDER=openai        # openai | gemini | anthropic

# --- OpenAI (agent brain; used when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Anthropic (agent brain; used when LLM_PROVIDER=anthropic; also the automatic
# fallback if the configured provider's key above is unset) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Google Gemini (agent brain; used when LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash   # set to your exact model id

# --- OpenFDA (optional; works keyless at a lower rate limit) ---
OPENFDA_API_KEY=

# --- HuggingFace (voice: STT + TTS + language ID; optional) ---
HUGGINGFACE_API_KEY=                        # if unset, voice notes ask the user to type instead
HF_STT_MODEL=openai/whisper-large-v3        # multilingual STT (high-resource langs)
HF_STT_LOWRESOURCE_MODEL=facebook/mms-1b-all  # dialect STT (Hokkien/Teochew); falls back to Whisper
HF_TTS_MODEL=facebook/mms-tts-eng           # TTS fallback; per-language mms-tts-<iso3> chosen at reply time
HF_LID_MODEL=facebook/fasttext-language-identification  # local language detection (downloaded, not API)

# --- MongoDB (dialect slang dictionary; optional) ---
MONGODB_URI=                                # if unset, slang grounding is disabled
MONGODB_DB=dosewise
MONGODB_SLANG_COLLECTION=dialect_slang

# --- Telegram (test channel) ---
TELEGRAM_BOT_TOKEN=          # from @BotFather
TELEGRAM_WEBHOOK_SECRET=     # any random string; only used in webhook mode

# --- Hermes VPS / deployment ---
VPS_URL=                     # public https base URL of the Hostinger VPS (webhook mode)
HERMES_HOST=0.0.0.0
HERMES_PORT=8000
HERMES_CHANNEL_MODE=polling  # polling (local) | webhook (VPS)
HERMES_TZ=Asia/Singapore     # timezone for interpreting medication schedule times

# --- Telegram test identity (Elder A from supabase/seed/seed.sql) ---
DEV_DEFAULT_ELDER_ID=00000000-0000-0000-0000-00000000000a
