# Supabase — fill these in a git-ignored .env (do NOT commit real values)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Anthropic (agent brain) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- OpenFDA (optional; works keyless at a lower rate limit) ---
OPENFDA_API_KEY=

# --- Telegram (test channel) ---
TELEGRAM_BOT_TOKEN=          # from @BotFather
TELEGRAM_WEBHOOK_SECRET=     # any random string; only used in webhook mode

# --- Hermes VPS / deployment ---
VPS_URL=                     # public https base URL of the Hostinger VPS (webhook mode)
HERMES_HOST=0.0.0.0
HERMES_PORT=8000
HERMES_CHANNEL_MODE=polling  # polling (local) | webhook (VPS)

# --- Telegram test identity (Elder A from supabase/seed/seed.sql) ---
DEV_DEFAULT_ELDER_ID=00000000-0000-0000-0000-00000000000a

# Deferred (voice stretch): HUGGINGFACE_API_KEY
