# Copy to .env.local (git-ignored) and fill in your values.
# Vite only exposes vars prefixed VITE_ to the browser bundle.

# Supabase project (same project the backend uses — see supabase/README.md)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Hermes orchestrator base URL (local: http://localhost:8000, prod: your VPS URL)
VITE_HERMES_URL=http://localhost:8000
