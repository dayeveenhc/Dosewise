# apps/web — fill these in a git-ignored .env (do NOT commit real values)
# Same Supabase project as the rest of the repo; Vite only exposes VITE_-prefixed
# vars to client code, so these mirror the root .env.example's SUPABASE_URL /
# SUPABASE_ANON_KEY under that prefix.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL of the running Hermes service (e.g. http://localhost:8000 in dev).
VITE_HERMES_URL=
